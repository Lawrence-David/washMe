NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/wash-me-ney-ney

CORS_ORIGIN=http://localhost:5173

# Shop time zone used to stamp order dates (the server's own zone is ignored)
APP_TIMEZONE=Asia/Manila
# How many days a login lasts
SESSION_DAYS=7
# Number of reverse proxies in front of the API (Render, Railway, Nginx...). 0 when running directly.
TRUST_PROXY=0

# Development-only logins created by "npm run seed". Never used when NODE_ENV=production.
# For a real shop, create the owner with: npm run create-user -- --username <name> --role owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_NAME="Shop Owner"
SEED_OWNER_PASSWORD=dev-owner-pass
SEED_STAFF_USERNAME=staff
SEED_STAFF_NAME="Front Desk"
SEED_STAFF_PASSWORD=dev-staff-pass
